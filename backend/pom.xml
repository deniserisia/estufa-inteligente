<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>br.ufc</groupId>
    <artifactId>estufa-backend</artifactId>
    <version>1.0.0</version>
    <name>estufa-backend</name>
    <description>Cliente do Gateway (TCP + Protobuf) exposto como API REST para o Angular</description>

    <properties>
        <java.version>17</java.version>
        <!--
          As classes Java do ../proto/estufa.proto já estão geradas em
          src/main/java/br/ufc/estufa/proto (protoc 30.2). O runtime precisa ser
          da mesma versão ou mais novo. Se mudar o .proto, gere de novo com:
          python scripts/gerar_proto.py --java   (na raiz do projeto)
        -->
        <protobuf.version>4.30.2</protobuf.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
